# Backend Fastify. I valori vengono letti da process.env.
# Il server non carica automaticamente questo file: usare --env-file o Docker.

# Porta HTTP e WebSocket interna al processo/container (default server: 3000).
PORT=3000

# Indirizzo di ascolto (default: 0.0.0.0; mantenerlo nel container).
HOST=0.0.0.0

# File SQLite; la directory padre deve esistere ed essere scrivibile.
# Senza variabile il server usa :memory: e perde i dati al riavvio.
# Nel container montare un volume su /data.
DATABASE_PATH=/data/epochs.sqlite

# Origini browser ammesse, separate da virgole e comprensive di protocollo/porta.
# In produzione sostituire con l'origine HTTPS del frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Livelli pino: fatal, error, warn, info, debug, trace, silent.
# Default server senza variabile: warn; default immagine Docker: info.
LOG_LEVEL=info
