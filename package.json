{
  "name": "the-epochs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "gdd:cards": "tsx tools/gdd-to-cards.ts",
    "content:validate": "tsx tools/content-validate.ts",
    "validate:scenarios": "tsx tools/validate-scenarios.ts",
    "art:placeholders": "tsx tools/art-placeholders.ts",
    "art:build": "tsx tools/art-build.ts",
    "art:ingest": "tsx tools/art-ingest.ts",
    "art:export-prompts": "tsx tools/art-export-prompts.ts",
    "sim": "pnpm --filter @epochs/sim start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "test:e2e": "pnpm --filter @epochs/web test:e2e"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "immer": "11.1.21",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
